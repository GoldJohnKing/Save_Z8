<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveZ8.UI.ViewModels"
        x:Class="SaveZ8.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Save Z8 — 尼康 Z8/Z9 黑位修复工具"
        Width="900" Height="650"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Hyperlink-style button for the "已修复" status -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="SteelBlue" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="DodgerBlue" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="🚑" FontSize="32" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Save Z8" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="尼康 Z8/Z9 ISO 64 黑位 −1 LSB 缺陷批量修复"
                           FontSize="12" Foreground="Gray" />
            </StackPanel>
        </StackPanel>

        <!-- File List -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto">
            <Border Grid.Row="0" BorderBrush="#333" BorderThickness="1" CornerRadius="4">
                <Grid RowDefinitions="Auto,*">
                    <!-- Column headers -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto"
                          Background="#2A2A2A" Margin="8,6">
                        <TextBlock Grid.Column="0" Text="文件名" FontSize="12" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="状态" FontSize="12" FontWeight="Bold"
                                   Margin="12,0,0,0" MinWidth="120" />
                        <TextBlock Grid.Column="2" Text="修复像素" FontSize="12" FontWeight="Bold"
                                   Margin="12,0,0,0" MinWidth="80" TextAlignment="Right" />
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileItemViewModel">
                                    <Border Padding="8,4" BorderBrush="#222" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                       VerticalAlignment="Center" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Panel Grid.Column="1">
                                                <!-- Plain status -->
                                                <TextBlock Text="{Binding Status}"
                                                           VerticalAlignment="Center" FontSize="12"
                                                           Foreground="SteelBlue"
                                                           Margin="12,0,0,0" MinWidth="120"
                                                           IsVisible="{Binding !CanOpenOutput}" />
                                                <!-- Clickable "已修复": opens Explorer pre-selected -->
                                                <Button Classes="link"
                                                        Content="{Binding Status}"
                                                        Command="{Binding OpenOutputCommand}"
                                                        IsVisible="{Binding CanOpenOutput}" />
                                            </Panel>
                                            <TextBlock Grid.Column="2" Text="{Binding PixelsFixed, StringFormat='{}{0:N0}'}"
                                                       VerticalAlignment="Center" FontSize="12"
                                                       Foreground="Gray" Margin="12,0,0,0" MinWidth="80"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- File Picker Button -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal"
                        Spacing="12" Margin="0,8,0,0">
                <Button Content="📁 添加 NEF 文件..." Click="OnBrowseFiles" Padding="20,8" FontSize="13" />
                <Button Content="🗑 清除列表" Command="{Binding ClearAllCommand}" Padding="16,8" />
            </StackPanel>
        </Grid>

        <!-- Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0"
                    HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="Gray"
                       Margin="0,0,12,0" />
            <Button Content="取消" Command="{Binding CancelCommand}" Padding="16,6"
                    IsVisible="{Binding IsProcessing}" />
            <Button Content="🚑 开始修复" Command="{Binding ProcessAllCommand}"
                    Padding="24,8" FontSize="14" FontWeight="Bold"
                    Classes="accent"
                    IsEnabled="{Binding !IsProcessing}" />
        </StackPanel>
    </Grid>
</Window>
